---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowField from '../components/FlowField.astro';
import MeshRefinement from '../components/MeshRefinement.astro';

const base = import.meta.env.BASE_URL;
const proposalUrl = `${base}documents/hobbs-cfd-meshing-proposal.pdf`;
---
<BaseLayout title="Project" description="A proposed AI-assisted CFD meshing and verification workflow for hypersonic simulations.">
  <article class="project-page">
    <section class="hero" aria-labelledby="project-title">
      <div class="hero-heading">
        <p class="eyebrow">RESEARCH PROJECT · FALL 2026</p>
        <h1 id="project-title"><span>AI-assisted meshing,</span><em>held to CFD verification.</em></h1>
      </div>
      <div class="hero-copy">
        <p class="lede">Before CFD can be used to investigate the physics of interest, the flow solution has to be shown independent of the mesh—a prerequisite that often takes substantial engineering time and compute. This project is a controlled comparison of manual and agent-assisted mesh development for RAM-C II hypersonic CFD. The agent may propose and document repeatable changes, while the engineer retains topology review and solution-acceptance decisions.</p>
        <div class="tags" aria-label="Project topics">
          <span>RAM-C II benchmark</span>
          <span>Hypersonic CFD</span>
          <span>Mesh verification</span>
          <span>Human-in-the-loop AI</span>
        </div>
        <div class="hero-actions">
          <a class="text-link" href="#workflow">Explore the workflow</a>
          <button class="proposal-button" type="button" data-open-proposal>Read the full proposal <span aria-hidden="true">↗</span></button>
        </div>
      </div>

      <FlowField />
      <figure class="mesh-hero border border-rule bg-[#faf9f5] p-4 sm:p-5" aria-hidden="true">
        <svg viewBox="0 0 660 395" role="img" aria-labelledby="hero-mesh-title hero-mesh-desc">
          <title id="hero-mesh-title">Illustrative hypersonic CFD mesh around a blunt body</title>
          <desc id="hero-mesh-desc">A structured mesh is clustered at the blunt-body wall, with a bow shock and a refined wake region labeled.</desc>
          <rect width="660" height="395" fill="#faf9f5" />
          <rect x="24" y="31" width="612" height="311" fill="none" stroke="#9ba39c" stroke-width="0.8" />
          <g fill="none" stroke="#9ba39c" stroke-width="0.75">
            <path d="M24 68 C145 65 205 76 262 119 C305 151 379 145 459 106 L636 73" />
            <path d="M24 99 C145 96 202 108 253 143 C298 174 375 171 466 130 L636 104" />
            <path d="M24 130 C141 127 197 137 246 166 C294 196 374 197 476 156 L636 136" />
            <path d="M24 161 C132 159 186 166 235 188 C286 211 374 219 487 184 L636 168" />
            <path d="M24 244 C132 246 186 239 235 217 C286 194 374 186 487 221 L636 237" />
            <path d="M24 275 C141 278 197 268 246 239 C294 209 374 208 476 249 L636 269" />
            <path d="M24 306 C145 309 202 297 253 262 C298 231 375 234 466 275 L636 301" />
            <path d="M80 31 C128 94 166 151 234 187 M80 342 C128 279 166 222 234 206" />
            <path d="M137 31 C173 94 202 146 251 173 M137 342 C173 279 202 227 251 220" />
            <path d="M194 31 C217 89 239 137 269 160 M194 342 C217 284 239 236 269 233" />
            <path d="M251 31 C264 86 280 132 289 151 M251 342 C264 287 280 241 289 242" />
            <path d="M308 31 C313 85 325 129 311 146 M308 342 C313 288 325 244 311 247" />
            <path d="M365 31 C362 84 369 127 334 143 M365 342 C362 289 369 247 334 250" />
            <path d="M422 31 C411 83 413 126 359 139 M422 342 C411 290 413 247 359 254" />
            <path d="M479 31 C460 82 458 124 385 135 M479 342 C460 291 458 250 385 258" />
            <path d="M536 31 C509 81 503 123 411 132 M536 342 C509 292 503 251 411 261" />
            <path d="M593 31 C557 79 548 122 438 129 M593 342 C557 294 548 252 438 264" />
          </g>
          <g fill="none" stroke="#6c8e98" stroke-width="0.8">
            <path d="M207 198 C222 166 250 147 288 137 L493 91" />
            <path d="M211 201 C227 174 252 157 291 147 L496 102" />
            <path d="M214 204 C230 181 255 167 294 157 L499 113" />
            <path d="M215 208 C232 188 257 177 296 167 L501 124" />
            <path d="M215 212 C232 222 257 233 296 243 L501 286" />
            <path d="M214 216 C230 229 255 243 294 253 L499 297" />
            <path d="M211 219 C227 236 252 253 291 263 L496 308" />
            <path d="M207 222 C222 245 250 264 288 274 L493 319" />
          </g>
          <path d="M207 210 C210 184 235 164 270 153 L494 105 L494 315 L270 267 C235 256 210 236 207 210 Z" fill="#f5f3ee" stroke="#284854" stroke-width="1.5" />
          <path d="M207 210 C210 184 235 164 270 153 L494 105 M207 210 C210 236 235 256 270 267 L494 315" fill="none" stroke="#a33e36" stroke-width="1.2" />
          <path d="M151 87 C184 119 191 166 191 210 C191 254 184 301 151 333" fill="none" stroke="#a33e36" stroke-width="1.2" stroke-dasharray="5 5" />
          <line x1="52" y1="210" x2="119" y2="210" stroke="#284854" stroke-width="1" />
          <path d="M119 210 l-8 -4 v8 z" fill="#284854" />
          <text x="39" y="54" fill="#5d645f" font-family="IBM Plex Mono, monospace" font-size="10">FREESTREAM</text>
          <text x="110" y="84" fill="#a33e36" font-family="IBM Plex Mono, monospace" font-size="10">BOW SHOCK</text>
          <text x="431" y="95" fill="#a33e36" font-family="IBM Plex Mono, monospace" font-size="10">WALL</text>
          <text x="501" y="333" fill="#5d645f" font-family="IBM Plex Mono, monospace" font-size="10">WAKE</text>
          <text x="26" y="373" fill="#5d645f" font-family="IBM Plex Mono, monospace" font-size="10">ILLUSTRATIVE BODY-FITTED MESH</text>
        </svg>
        <figcaption>Resolution is not uniform: the wall, shock, and wake require different mesh decisions.</figcaption>
      </figure>
    </section>

    <section class="split-section challenge">
      <div>
        <p class="section-label">01 / THE CHALLENGE</p>
        <h2>A mesh can pass geometric checks and still miss the physics that matters.</h2>
      </div>
      <div class="body-copy">
        <p>Hypersonic flows contain shocks, boundary layers, surface-heating regions, and wakes with very different resolution needs. Surface spacing, wall-normal cells, growth rates, local refinement, and element quality all affect the resulting solution.</p>
        <p>Cell volume, skewness, orthogonality, and aspect ratio are necessary checks, but they do not by themselves show that pressure, heat flux, shock position, or wake structure are resolved. Finding a mesh that is both usable and trustworthy takes repeated construction, solver runs, inspection, and refinement.</p>
      </div>
    </section>

    <section id="workflow" class="workflow-section" aria-labelledby="workflow-title">
      <div class="section-heading">
        <p class="section-label">02 / THE APPROACH</p>
        <h2 id="workflow-title">A repeatable mesh-to-solution loop.</h2>
        <p>The agent will work from a fixed geometry, freestream state, flow model, wall condition, angle of attack, solver setup, quantities of interest, and compute limits. Each mesh change will be recorded with its affected region, changed parameter, and resulting solution response.</p>
      </div>
      <div class="workflow-grid" aria-label="Proposed AI-assisted meshing workflow">
        <div class="workflow-card"><span>01</span><h3>Fix the case definition</h3><p>Hold the RAM-C II geometry, freestream state, flow model, wall condition, angle of attack, quantities of interest, and compute limits explicit.</p></div>
        <div class="workflow-arrow" aria-hidden="true">→</div>
        <div class="workflow-card agent"><span>02</span><h3>Propose and record changes</h3><p>The agent adjusts point counts, first-cell spacing, growth rates, and local refinement, then records the affected region and changed parameter.</p></div>
        <div class="workflow-arrow" aria-hidden="true">→</div>
        <div class="workflow-card human"><span>03</span><h3>Review topology</h3><p>Topology changes pause for human inspection in Pointwise before the mesh is modified.</p></div>
        <div class="workflow-arrow" aria-hidden="true">→</div>
        <div class="workflow-card"><span>04</span><h3>Solve, verify, refine</h3><p>US3D results, mesh checks, residual behavior, surface pressure, heat flux, and flowfield slices determine the next targeted refinement.</p></div>
      </div>
      <div class="responsibility-key">
        <span><i class="agent-dot"></i> Agent assists with repeatable changes and records</span>
        <span><i class="human-dot"></i> Engineer reviews consequential topology decisions</span>
        <span><i class="verify-dot"></i> Verification determines whether the solution is adequate</span>
      </div>
    </section>

    <section class="verification split-section">
      <div>
        <p class="section-label">03 / WHAT COUNTS AS EVIDENCE</p>
        <h2>Verification is more than a quality report.</h2>
        <p class="section-intro">The workflow combines deterministic calculations and literature-based criteria for mesh checks with solution-based evidence from systematic grid refinement.</p>
      </div>
      <div class="verification-cards">
        <article>
          <p class="card-label">NEAR-WALL RESOLUTION</p>
          <p class="equation"><i>y</i><sup>+</sup> = <i>u</i><sub>τ</sub><i>y</i> / <i>ν</i></p>
          <p>First-cell spacing depends on the wall treatment, flow conditions, and numerical model. A target <i>y</i><sup>+</sup> is not a universal mesh setting.</p>
        </article>
        <article>
          <p class="card-label">GRID CONVERGENCE</p>
          <p class="equation"><i>φ</i>(<i>h</i>) = <i>φ</i><sub>0</sub> + <i>C</i><i>h</i><sup>p</sup></p>
          <p>Across systematic coarse, medium, and fine grids, a quantity of interest should approach a limiting value as the characteristic cell size <i>h</i> decreases.</p>
        </article>
        <article>
          <p class="card-label">SOLUTION QUANTITIES</p>
          <div class="quantity-equations">
            <span><i>C</i><sub>p</sub> = (<i>p</i> − <i>p</i><sub>∞</sub>) / (½<i>ρ</i><sub>∞</sub><i>U</i><sub>∞</sub><sup>2</sup>)</span>
            <span><i>q</i><sub>w</sub> = −<i>k</i>(∂<i>T</i>/∂<i>n</i>)<sub>w</sub></span>
            <span>Δ<i>x</i><sub>s</sub> = |<i>x</i><sub>s</sub> − <i>x</i><sub>s,ref</sub>|</span>
            <span><i>R</i><sub>n</sub> / <i>R</i><sub>0</sub></span>
          </div>
          <p>Surface-pressure coefficient, wall heat flux, shock position, and residual behavior are checked across a topologically consistent grid family. A low nonlinear residual alone does not establish that discretization error is resolved.</p>
        </article>
      </div>
    </section>

    <section class="mesh-family" aria-labelledby="mesh-family-title">
      <div class="section-heading compact">
        <p class="section-label">04 / SYSTEMATIC REFINEMENT</p>
        <h2 id="mesh-family-title">Refine the mesh without changing the question.</h2>
        <p>Pressure and heat-flux changes can only be compared when the meshes refine the same geometry and topology in a controlled way.</p>
      </div>
      <MeshRefinement />
      <div class="mesh-family-grid" aria-hidden="true">
        <figure>
          <svg viewBox="0 0 220 150" role="img" aria-label="Coarse structured mesh around a blunt body">
            <rect width="220" height="150" fill="#faf9f5"/><rect x="8" y="8" width="204" height="112" fill="none" stroke="#c7cec8"/>
            <g fill="none" stroke="#9ba39c" stroke-width="1"><path d="M8 30H212M8 55H212M8 80H212M8 105H212M35 8V120M72 8V120M109 8V120M146 8V120M183 8V120"/></g>
            <path d="M91 64 C94 51 108 42 131 38 L167 49 L167 101 L131 112 C108 108 94 99 91 86Z" fill="#f5f3ee" stroke="#284854" stroke-width="1.4"/>
            <path d="M91 75H167" stroke="#a33e36" stroke-width="1"/>
          </svg>
          <figcaption><b>COARSE</b><span>Lowest cell count</span></figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 220 150" role="img" aria-label="Medium structured mesh around a blunt body">
            <rect width="220" height="150" fill="#faf9f5"/><rect x="8" y="8" width="204" height="112" fill="none" stroke="#c7cec8"/>
            <g fill="none" stroke="#9ba39c" stroke-width="0.75"><path d="M8 21H212M8 39H212M8 57H212M8 75H212M8 93H212M8 111H212M25 8V120M46 8V120M67 8V120M88 8V120M109 8V120M130 8V120M151 8V120M172 8V120M193 8V120"/></g>
            <path d="M91 64 C94 51 108 42 131 38 L167 49 L167 101 L131 112 C108 108 94 99 91 86Z" fill="#f5f3ee" stroke="#284854" stroke-width="1.4"/>
            <path d="M91 75H167" stroke="#a33e36" stroke-width="1"/>
          </svg>
          <figcaption><b>MEDIUM</b><span>Systematic refinement</span></figcaption>
        </figure>
        <figure>
          <svg viewBox="0 0 220 150" role="img" aria-label="Fine structured mesh around a blunt body">
            <rect width="220" height="150" fill="#faf9f5"/><rect x="8" y="8" width="204" height="112" fill="none" stroke="#c7cec8"/>
            <g fill="none" stroke="#9ba39c" stroke-width="0.55"><path d="M8 17H212M8 29H212M8 41H212M8 53H212M8 65H212M8 77H212M8 89H212M8 101H212M8 113H212M18 8V120M32 8V120M46 8V120M60 8V120M74 8V120M88 8V120M102 8V120M116 8V120M130 8V120M144 8V120M158 8V120M172 8V120M186 8V120M200 8V120"/></g>
            <path d="M91 64 C94 51 108 42 131 38 L167 49 L167 101 L131 112 C108 108 94 99 91 86Z" fill="#f5f3ee" stroke="#284854" stroke-width="1.4"/>
            <path d="M91 75H167" stroke="#a33e36" stroke-width="1"/>
          </svg>
          <figcaption><b>FINE</b><span>Highest cell count</span></figcaption>
        </figure>
      </div>
    </section>

    <section class="evaluation split-section">
      <div>
        <p class="section-label">05 / THE COMPARISON</p>
        <h2>What changes, and what must still agree?</h2>
      </div>
      <div class="body-copy">
        <p>The AI-assisted and manual workflows will use the same RAM-C II case, solver setup, mesh-acceptance criteria, and quantities of interest. Engineering time will be recorded separately from solver wall time and computational cost. A time reduction is meaningful only if the accepted grid family gives comparable surface pressure, heat flux, and grid-convergence evidence.</p>
        <div class="comparison-grid">
          <div><p class="card-label">MANUAL WORKFLOW</p><p>Engineer builds and revises the mesh, tracks iterations, runs checks, and constructs the grid family.</p></div>
          <div><p class="card-label">AGENT-ASSISTED WORKFLOW</p><p>Agent proposes repeatable changes and records their effects. The engineer retains review and acceptance decisions.</p></div>
        </div>
        <p class="measure-line"><b>Measure:</b> engineering time · surface pressure · heat flux · mesh iterations · failed solver runs · expert interventions · computational cost</p>
      </div>
    </section>

    <section class="proposal-cta">
      <p class="section-label">PROJECT PROPOSAL</p>
      <h2>Read the full one-pager.</h2>
      <p>The proposal describes the RAM-C II test case, planned workflow, and verification approach in detail.</p>
      <button class="proposal-button light" type="button" data-open-proposal>Open proposal PDF <span aria-hidden="true">↗</span></button>
    </section>

    <section class="north-star">
      <p class="section-label">THE QUESTION</p>
      <blockquote>Can AI reduce engineering time spent on meshing while preserving pressure, heat flux, and grid-convergence behavior?</blockquote>
    </section>

    <section class="public-boundary">
      <p class="section-label">PUBLIC-DATA BOUNDARY</p>
      <p>This public portfolio uses only publicly available geometries, flight conditions, and reference data. It does not include proprietary, employer-owned, sensitive, or export-controlled data, simulations, or results.</p>
    </section>
    <aside class="professor-note">“If this works, we’ll be on Wall Street!” — Professor Harris, 22 September 2026</aside>
  </article>

  <dialog id="proposal-dialog" class="proposal-dialog" aria-labelledby="proposal-title">
    <div class="proposal-dialog-header">
      <div><p class="section-label">PROJECT PROPOSAL</p><h2 id="proposal-title">AI-Assisted CFD Meshing and Verification</h2></div>
      <button type="button" class="close-dialog" data-close-proposal>Close</button>
    </div>
    <iframe src={proposalUrl} title="Full project proposal PDF"></iframe>
    <div class="proposal-dialog-footer">
      <a href={proposalUrl} target="_blank" rel="noreferrer">Open in a new tab</a>
      <a href={proposalUrl} download>Download PDF</a>
    </div>
  </dialog>

  <script>
    const proposalDialog = document.querySelector<HTMLDialogElement>('#proposal-dialog');
    document.querySelectorAll<HTMLButtonElement>('[data-open-proposal]').forEach((button) => {
      button.addEventListener('click', () => proposalDialog?.showModal());
    });
    document.querySelector<HTMLButtonElement>('[data-close-proposal]')?.addEventListener('click', () => proposalDialog?.close());
    proposalDialog?.addEventListener('click', (event) => {
      if (event.target === proposalDialog) proposalDialog.close();
    });
  </script>

  <style>
    .project-page { --warm:#c49a3a; --slate:#202522; --red:#a33e36; }
    .hero { display:grid; grid-template-columns:minmax(0,0.75fr) minmax(25rem,1.25fr); gap:2.25rem 3rem; align-items:start; padding-bottom:6rem; }
    .hero-heading { grid-column:1 / -1; }
    .eyebrow,.section-label,.card-label { font:600 .7rem/1.2 'IBM Plex Mono',monospace; letter-spacing:.14em; color:var(--red); }
    .hero h1 { margin-top:1.15rem; max-width:none; font-family:'DM Serif Display',Georgia,serif; font-size:clamp(3.45rem,6.45vw,5.6rem); font-weight:400; line-height:.94; letter-spacing:-.055em; }
    .hero h1 span,.hero h1 em { display:block; white-space:nowrap; }
    .hero h1 em { color:var(--red); font-style:normal; }
    .lede { max-width:38rem; margin-top:1.7rem; color:#5d645f; font-size:1.08rem; line-height:1.75; }
    .tags { display:flex; flex-wrap:wrap; gap:.5rem; margin-top:1.6rem; }
    .tags span { border:1px solid #c7cec8; padding:.42rem .65rem; color:#5d645f; font:500 .68rem 'IBM Plex Mono',monospace; }
    .hero-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1.25rem; margin-top:2rem; font:500 .75rem 'IBM Plex Mono',monospace; }
    .text-link { border-bottom:1px solid var(--slate); padding-bottom:.3rem; color:var(--slate); }
    .proposal-button { border:1px solid #5d645f; background:#5d645f; padding:.7rem .9rem; color:#faf9f5; font:500 .73rem 'IBM Plex Mono',monospace; transition:background .2s,color .2s; }
    .proposal-button:hover { background:var(--red); border-color:var(--red); }
    .mesh-hero { display:none; }
    .split-section { display:grid; grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr); gap:5rem; border-top:1px solid #c7cec8; padding:6rem 0; }
    h2 { margin-top:.9rem; font-family:'DM Serif Display',Georgia,serif; font-size:clamp(2.2rem,4.2vw,3.65rem); font-weight:400; line-height:1.03; letter-spacing:-.05em; }
    .body-copy { color:#5d645f; font-size:1rem; line-height:1.85; }
    .body-copy p + p { margin-top:1.25rem; }
    .section-intro { margin-top:1.35rem; color:#5d645f; line-height:1.75; }
    .workflow-section { border-top:1px solid #c7cec8; padding:6rem 0; }
    .section-heading { max-width:48rem; }
    .section-heading > p:last-child { margin-top:1.25rem; color:#5d645f; line-height:1.75; }
    .workflow-grid { display:grid; grid-template-columns:1fr auto 1fr auto 1fr auto 1fr; align-items:stretch; gap:.7rem; margin-top:3rem; }
    .workflow-card { border:1px solid #c7cec8; padding:1.25rem; background:#faf9f5; }
    .workflow-card.agent { border-color:var(--warm); background:#fbf7e9; }
    .workflow-card.human { border-color:var(--red); }
    .workflow-card span { color:var(--red); font:600 .67rem 'IBM Plex Mono',monospace; }
    .workflow-card h3 { margin-top:1.4rem; font-family:'DM Serif Display',Georgia,serif; font-size:1.38rem; font-weight:400; line-height:1.05; }
    .workflow-card p { margin-top:.65rem; color:#5d645f; font-size:.83rem; line-height:1.65; }
    .workflow-arrow { align-self:center; color:var(--warm); font-size:1.2rem; }
    .responsibility-key { display:flex; flex-wrap:wrap; gap:1.2rem 1.8rem; margin-top:1.25rem; color:#5d645f; font:500 .67rem/1.5 'IBM Plex Mono',monospace; }
    .responsibility-key i { display:inline-block; width:.5rem; height:.5rem; margin-right:.35rem; }
    .agent-dot { background:var(--warm); }.human-dot { background:var(--red); }.verify-dot { background:#202522; }
    .verification { align-items:start; }
    .verification-cards { display:grid; gap:1px; border:1px solid #c7cec8; background:#c7cec8; }
    .verification-cards article { padding:1.4rem 1.5rem; background:#faf9f5; }
    .equation { margin:1rem 0; color:var(--slate); font:italic 1.7rem Georgia,serif; }
    .equation sub,.equation sup { font-size:.62em; font-style:normal; }
    .verification-cards article > p:last-child { color:#5d645f; font-size:.88rem; line-height:1.7; }
    .quantity-equations { display:grid; grid-template-columns:1fr; gap:.4rem; margin:1rem 0; overflow-x:auto; color:var(--slate); font:italic clamp(1rem,2.2vw,1.45rem)/1.45 Georgia,serif; }
    .quantity-equations span { white-space:nowrap; }
    .quantity-equations sub,.quantity-equations sup { font-size:.65em; font-style:normal; }
    .mesh-family { border-top:1px solid #c7cec8; padding:6rem 0; }
    .section-heading.compact { max-width:57rem; }
    .mesh-family-grid { display:none; }
    .mesh-family-grid figure { margin:0; border:1px solid #c7cec8; padding:.9rem; background:#faf9f5; }
    .mesh-family-grid svg { display:block; width:100%; height:auto; }
    .mesh-family-grid figcaption { display:flex; justify-content:space-between; gap:1rem; margin-top:.8rem; color:#5d645f; font:500 .66rem 'IBM Plex Mono',monospace; }
    .mesh-family-grid b { color:var(--red); font-weight:600; }
    .comparison-grid { display:grid; grid-template-columns:1fr 1fr; gap:1px; margin-top:1.5rem; border:1px solid #c7cec8; background:#c7cec8; }
    .comparison-grid > div { padding:1.25rem; background:#faf9f5; }
    .comparison-grid > div p:last-child { margin-top:.8rem; font-size:.88rem; line-height:1.65; }
    .measure-line { margin-top:1.4rem; border-left:2px solid var(--red); padding-left:1rem; color:#5d645f; font:.73rem/1.7 'IBM Plex Mono',monospace; }
    .measure-line b { color:var(--slate); }
    .proposal-cta { margin:0 calc(50% - 50vw); padding:6rem max(1.25rem,calc((100vw - 1024px)/2)); background:var(--slate); color:#faf9f5; text-align:center; }
    .proposal-cta .section-label { color:#ead7d2; }.proposal-cta h2 { margin-top:.8rem; }.proposal-cta p:not(.section-label) { max-width:35rem; margin:1rem auto 1.75rem; color:#f5f3ee; line-height:1.7; }
    .proposal-button.light { border-color:#9ba39c; background:#5d645f; }.proposal-button.light:hover { background:#faf9f5; border-color:#faf9f5; color:var(--slate); }
    .north-star { margin:0 calc(50% - 50vw); padding:6rem max(1.25rem,calc((100vw - 1024px)/2)); text-align:center; background:#f5f3ee; }
    .north-star blockquote { max-width:48rem; margin:1.2rem auto 0; font-family:'DM Serif Display',Georgia,serif; font-size:clamp(2.2rem,4.5vw,4rem); line-height:1.06; letter-spacing:-.055em; }
