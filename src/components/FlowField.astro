<figure class="flow-field" aria-labelledby="flow-title flow-desc">
  <svg viewBox="24 32 612 304" role="img">
    <title id="flow-title">Animated illustrative CFD-style flow field</title>
    <desc id="flow-desc">A colored scalar field and contour lines move through a rectangular computational domain. It is an illustrative visual, not simulation output.</desc>
    <defs>
      <linearGradient id="base" x1="0" x2="1"><stop stop-color="#123c65"/><stop offset=".5" stop-color="#087f8c"/><stop offset="1" stop-color="#123c65"/></linearGradient>
      <radialGradient id="warm"><stop stop-color="#dc3828"/><stop offset=".3" stop-color="#f0bc32"/><stop offset=".7" stop-color="#35b779" stop-opacity=".72"/><stop offset="1" stop-color="#35b779" stop-opacity="0"/></radialGradient>
      <radialGradient id="cool"><stop stop-color="#1cc5b7" stop-opacity=".8"/><stop offset="1" stop-color="#1cc5b7" stop-opacity="0"/></radialGradient>
      <clipPath id="domain"><rect x="24" y="32" width="612" height="304"/></clipPath>
      <filter id="blur"><feGaussianBlur stdDeviation="10"/></filter>
    </defs>
    <g clip-path="url(#domain)">
      <rect x="24" y="32" width="612" height="304" fill="url(#base)"/>
      <g filter="url(#blur)">
        <ellipse class="field a" cx="180" cy="192" rx="180" ry="100" fill="url(#warm)"/>
        <ellipse class="field b" cx="355" cy="218" rx="165" ry="115" fill="url(#warm)"/>
        <ellipse class="field c" cx="520" cy="138" rx="190" ry="72" fill="url(#cool)"/>
        <ellipse class="field d" cx="505" cy="283" rx="185" ry="68" fill="url(#cool)"/>
      </g>
      <g class="contours" fill="none" stroke="#f7f2dc" stroke-opacity=".5" stroke-width=".8">
        <path d="M-10 86 C105 58 188 90 264 110 S407 158 497 119 S594 82 676 105"/>
        <path d="M-10 119 C103 92 182 124 257 145 S403 191 493 151 S591 115 676 138"/>
        <path d="M-10 152 C101 127 178 158 250 179 S399 221 488 183 S588 149 676 171"/>
        <path d="M-10 185 C99 164 175 191 246 212 S397 250 486 215 S587 183 676 204"/>
        <path d="M-10 221 C99 242 175 215 246 194 S397 156 486 191 S587 223 676 202"/>
        <path d="M-10 255 C101 280 178 249 250 228 S399 186 488 224 S588 258 676 236"/>
        <path d="M-10 288 C103 315 182 283 257 262 S403 216 493 256 S591 292 676 269"/>
      </g>
      <g class="tracers" fill="#f7f2dc"><circle r="2.5"><animateMotion dur="4.2s" repeatCount="indefinite" path="M-10 119 C103 92 182 124 257 145 S403 191 493 151 S591 115 676 138"/></circle><circle r="2.2"><animateMotion dur="5.4s" begin="-2.5s" repeatCount="indefinite" path="M-10 255 C101 280 178 249 250 228 S399 186 488 224 S588 258 676 236"/></circle></g>
    </g>
    <text x="40" y="57">ILLUSTRATIVE FLOW FIELD EXAMPLE</text>
  </svg>
</figure>

<style>
  .flow-field { margin:2rem 0 0; } svg { display:block; width:100%; height:auto; } text { fill:#f7f2dc; font:500 7px 'IBM Plex Mono',monospace; letter-spacing:.06em; } .field { transform-box:fill-box; transform-origin:center; animation:drift 7s ease-in-out infinite alternate; }.b { animation-delay:-3s; animation-duration:8s; }.c { animation-delay:-2s; }.d { animation-delay:-5s; }.contours { stroke-dasharray:5 7; animation:contour 5s linear infinite; } figcaption { margin-top:.8rem; border-top:1px solid #e2e5e1; padding-top:.75rem; color:#5d645f; font:500 .68rem/1.5 'IBM Plex Mono',monospace; } @keyframes drift { to { transform:translate(22px,-10px) scale(1.08); } } @keyframes contour { to { stroke-dashoffset:-72; } } @media (prefers-reduced-motion:reduce) { .field,.contours { animation:none; }.tracers { display:none; } }
</style>
