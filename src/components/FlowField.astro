---
import flowField from '../assets/flow-field.gif';
import flowFieldStill from '../assets/flow-field-still.png';
---

<figure class="flow-field" aria-labelledby="flow-title flow-description">
  <picture>
    <source media="(prefers-reduced-motion: reduce)" srcset={flowFieldStill.src} />
    <img
      src={flowField.src}
      width={flowField.width}
      height={flowField.height}
      alt="Animated illustrative Mach-number field around a blunt cone with a detached bow shock"
      decoding="async"
    />
  </picture>
  <div class="mach-key" aria-label="Mach-number color scale from zero to twenty">
    <span>M 0</span>
    <span class="colorbar" aria-hidden="true"></span>
    <span>20</span>
  </div>
  <h2 id="flow-title" class="sr-only">Illustrative animated hypersonic Mach-number field</h2>
  <p id="flow-description" class="sr-only">A procedural, looping GIF shows a high-Mach freestream, a sharp detached bow shock, and a lower-Mach post-shock region around a blunt cone. It is explanatory artwork, not solver output.</p>
</figure>

<style>
  .flow-field { margin: 2rem 0 0; }
  .flow-field picture, .flow-field img { display: block; width: 100%; height: auto; }
  .mach-key { display: grid; grid-template-columns: auto minmax(8rem, 1fr) auto; align-items: center; gap: .55rem; margin-top: .55rem; color: #5d645f; font: 500 .6rem/1 'IBM Plex Mono', monospace; }
  .colorbar { height: .42rem; background: linear-gradient(90deg, #081d58, #123f82 12%, #196c9b 25%, #1f97ac 40%, #3db5b0 60%, #7fcdbb 80%, #cdebc1); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
</style>
