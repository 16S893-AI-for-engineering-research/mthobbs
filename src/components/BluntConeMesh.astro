---
type Point = { x: number; y: number };

const cubic = (a: Point, b: Point, c: Point, d: Point, t: number): Point => {
  const u = 1 - t;
  return {
    x: u ** 3 * a.x + 3 * u ** 2 * t * b.x + 3 * u * t ** 2 * c.x + t ** 3 * d.x,
    y: u ** 3 * a.y + 3 * u ** 2 * t * b.y + 3 * u * t ** 2 * c.y + t ** 3 * d.y,
  };
};

const lerp = (a: Point, b: Point, t: number): Point => ({
  x: a.x + (b.x - a.x) * t,
  y: a.y + (b.y - a.y) * t,
});

// These boundaries reproduce the curved blunt nose and the diagonal mesh block
// in the supplied reference image.
const wallPoint = (s: number): Point => cubic(
  { x: 8, y: 374 },
  { x: 20, y: 286 },
  { x: 220, y: 270 },
  { x: 510, y: 245 },
  s,
);

// Keep a finite blunt nose instead of collapsing every cell to one point.
const outerPoint = (s: number): Point => cubic(
  { x: 8, y: 306 },
  { x: 22, y: 226 },
  { x: 250, y: 130 },
  { x: 480, y: 4 },
  s,
);

const normalLevels = [0, 0.006, 0.014, 0.025, 0.04, 0.06, 0.085, 0.12, 0.17, 0.235, 0.32, 0.43, 0.56, 0.71, 0.86, 1];
const stations = Array.from({ length: 42 }, (_, index) => index / 41);
const pointAt = (s: number, normal: number): Point => lerp(wallPoint(s), outerPoint(s), normal);
const pathFor = (points: Point[]) => points.map((point, index) => `${index === 0 ? 'M' : 'L'}${point.x.toFixed(2)} ${point.y.toFixed(2)}`).join(' ');
const streamwise = normalLevels.map((normal) => pathFor(stations.map((s) => pointAt(s, normal))));
const crosswise = stations.map((s) => pathFor(normalLevels.map((normal) => pointAt(s, normal))));
const wall = pathFor(Array.from({ length: 80 }, (_, index) => wallPoint(index / 79)));
const outer = pathFor(Array.from({ length: 80 }, (_, index) => outerPoint(index / 79)));
---

<figure class="blunt-cone-mesh" aria-labelledby="mesh-title mesh-description">
  <svg viewBox="0 0 520 384" role="img">
    <title id="mesh-title">Illustrative structured mesh around a blunt body</title>
    <desc id="mesh-description">A diagonal body-fitted mesh wraps around a rounded blunt surface. The cells are densely packed along the curved wall and open gradually toward the outer boundary.</desc>
    <g class="mesh-lines" fill="none">
      {streamwise.map((path) => <path d={path} />)}
      {crosswise.map((path) => <path d={path} />)}
    </g>
    <path class="outer-boundary" d={outer} />
    <path class="nose-cap" d="M8 306 L8 374" />
    <path class="body-wall" d={wall} />
  </svg>
</figure>

<style>
  .blunt-cone-mesh { margin: 0; border: 0; background: transparent !important; padding: 0; }
  .blunt-cone-mesh svg { display: block; width: 100%; height: auto; background: transparent !important; }
  .mesh-lines { stroke: #202522; stroke-width: .52; stroke-opacity: .62; }
  .outer-boundary { fill: none; stroke: #202522; stroke-width: .65; stroke-opacity: .78; }
  .nose-cap { fill: none; stroke: #202522; stroke-width: 1.65; stroke-linecap: round; }
  .body-wall { fill: none; stroke: #202522; stroke-width: 1.65; stroke-linecap: round; }
</style>
