---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Madison Taylor Hobbs — 16.S893 portfolio',
} = Astro.props;
const base = import.meta.env.BASE_URL;
const currentPath = new URL(Astro.request.url).pathname;
const navItems = [
  { href: base, label: 'Home' },
  { href: `${base}about/`, label: 'About' },
  { href: `${base}project/`, label: 'Project' },
  { href: `${base}dev-log/`, label: 'Dev log' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} | Madison Taylor Hobbs</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <header class="border-b border-rule">
      <nav class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-5 py-4 sm:px-8" aria-label="Main navigation">
        <a href={base} class="font-mono text-xs tracking-tight text-slate-accent">
          mthobbs<span class="text-graphite">/</span>16.S893
        </a>
        <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs">
          {navItems.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href || (item.href !== base && currentPath.startsWith(item.href)) ? 'page' : undefined}
              class:list={[
                'border-b pb-0.5 transition-colors',
                currentPath === item.href || (item.href !== base && currentPath.startsWith(item.href))
                  ? 'border-red-accent text-ink'
                  : 'border-transparent text-graphite hover:border-slate-accent hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
      <slot />
    </main>

    <footer class="border-t border-rule">
      <div class="mx-auto max-w-5xl px-5 py-5 font-mono text-[11px] text-graphite sm:px-8">
        16.S893 — AI Agents for Engineering Research · MIT
      </div>
    </footer>
  </body>
</html>
