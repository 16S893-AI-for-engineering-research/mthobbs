\DefineNamedColor{named}{mitred}    {rgb}{0.4588235294117647,0,0.0784313725490196}
\DefineNamedColor{named}{mitgray}   {rgb}{0.5450980392156862,0.5843137254901961,0.6196078431372549}
\DefineNamedColor{named}{darkgray}  {cmyk}{0,0,0,0.90}

%\mode<presentation
\mode<all>
\setbeamercolor{alerted text}{fg=mitred}
\setbeamercolor*{palette primary}{fg=mitred,bg=mitgray}
\setbeamercolor*{palette secondary}{bg=white,fg=mitgray}
\setbeamercolor*{palette tertiary}{bg=white,fg=darkgray}
\setbeamercolor*{palette quaternary}{bg=mitred,fg=white}
\setbeamercolor*{structure}{fg=mitred,bg=white}
\setbeamercolor{frametitle}{bg=white,fg=mitred}
\setbeamercolor{block title}{fg=red,bg=gray}
\setbeamercolor{block body}{fg=black,bg=gray!10!white}
\setbeamercolor{section in toc}{fg=black,bg=white}
\setbeamercolor*{titlelike}{fg=mitred,bg=white}

\setbeamercolor{bibliography entry author}{fg=mitred}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}