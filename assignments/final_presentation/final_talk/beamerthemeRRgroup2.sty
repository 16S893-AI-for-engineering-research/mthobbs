% -*- LaTeX Beamer theme RRgroup2-*-
% (C) 2022 Theo Rulko, Martin Hautefeuille
%          Massachusetts Institute of Technology (MIT)

\DeclareOptionBeamer{compress}{\beamer@compresstrue}
\ProcessOptionsBeamer
\mode<presentation>

% Set themes
\useoutertheme[footline=authorinstitutetitle]{smoothbars}
\useoutertheme[]{smoothbars}
\usecolortheme{RRgroup}
\useinnertheme[shadow=false]{rounded}
\setbeamertemplate{headline}{}           % Remove header
\setbeamertemplate{navigation symbols}{} % Remove nav buttons
\setbeamertemplate{frametitle continuation}[from second][\insertcontinuationcountroman]

% Blocks
\setbeamercolor{block title}{bg=black!20,fg=black}

% Fix font sizes and colors of bibliography
\defbeamertemplate{bibliography item}{my text}{\hfill\insertbiblabel \hss}
\setbeamerfont{bibliography entry author}{size=\footnotesize,series=\bfseries}
\usepackage{regexpatch}
\xpatchcmd*{\beamer@newblock}{\usebeamerfont}{\usebeamerfont*}{}{}

\setbeamerfont{bibliography item}{size=\footnotesize}
\setbeamerfont{bibliography entry author}{size=\footnotesize}
\setbeamerfont{bibliography entry title}{size=\footnotesize,series=\bfseries}
\setbeamerfont{bibliography entry location}{size=\footnotesize}
\setbeamerfont{bibliography entry note}{size=\footnotesize}

% Make prettier lists
\setbeamertemplate{itemize item}[circle]
\setbeamertemplate{enumerate items}[circle]
\setbeamertemplate{enumerate item}{
    \usebeamercolor[bg]{item projected}
    \tikz[baseline=(char.base)]{
        \node[shape=circle,fill=bg,draw,inner sep=1pt](char){
            \color{fg}\bfseries\footnotesize\insertenumlabel
        };
    }
}
\setbeamertemplate{section in toc}{
    \leavevmode\leftskip=2ex
    \llap{
        \usebeamerfont*{item projected}
        \usebeamercolor[bg]{item projected}
        \tikz[baseline=(char.base)]{
            \node[shape=circle,fill=bg,draw,inner sep=1pt,minimum size=1em,](char){\color{fg}\bfseries\footnotesize\inserttocsectionnumber};
        }
        \kern1.25ex
    }\inserttocsection\par
}

\setbeamertemplate{bibliography item}{}


% Set default font sizes
\setbeamerfont{block title}{size={}}
\setbeamerfont{block body}{size=\small}
\setbeamerfont{normal text}{size=\small}
\setbeamerfont{title}{series=\bfseries}
\setbeamerfont{title}{size=\LARGE}
\setbeamerfont{subtitle}{size=\large}
\setbeamerfont{frametitle}{size=\huge}
\setbeamerfont{author}{size=\large}
\setbeamerfont{institute}{size=\large}
\setbeamerfont{date}{size=\small}

% Define two footer options
\defbeamertemplate*{footline}{author+institution+page}{
    \begin{beamercolorbox}[wd=\paperwidth,ht=8mm,dp=2.5mm,
        leftskip=4mm,rightskip=4mm plus1fil]{separation line}
        \includegraphics[height=0.55cm]{mit-lockup-red.png}
        \usebeamerfont{section in head/foot}
        \hfill 
        \insertshortauthor \ --- \insertshorttitle
        \hfill \insertframenumber/\inserttotalframenumber
    \end{beamercolorbox}
}
\defbeamertemplate*{footline}{page}{
    \begin{beamercolorbox}[wd=\paperwidth,ht=8mm,dp=2.5mm,
        leftskip=4mm,rightskip=4mm plus1fil]{separation line}
        \usebeamerfont{section in head/foot}
        \hfill \insertframenumber/\inserttotalframenumber
    \end{beamercolorbox}
}

% Define slide title position and style
\setbeamertemplate{frametitle}{
    \nointerlineskip
    \begin{beamercolorbox}[sep=4mm,ht=1.9em,wd=\paperwidth]{frametitle}
        \vbox{}\vspace{-6mm}
        \strut\bfseries\insertframetitle\strut
    \end{beamercolorbox}
}

% Apply fancy footer to all slides
\usebackgroundtemplate{
    \includegraphics[width=\paperwidth,height=\paperheight]{background/background4.pdf}
}

% Define a title frame
\newcommand{\titleframe}{{
    \ifdefined\colorfulTitle
        \setbeamercolor{author}{fg=white}
        \setbeamercolor{date}{fg=white}
        \setbeamercolor{institute}{fg=white}
        \usebackgroundtemplate{
            \includegraphics[width=\paperwidth,height=\paperheight]{background/background5.pdf}
        }
    \fi
    \begin{frame}[plain]
        \vspace{1.0cm}
        \centering\includegraphics[height=0.7cm]{mit-black.png}
        \titlepage
    \end{frame}
    \ifdefined\colorfulTitle
        \setbeamercolor{author}{fg=black}
        \setbeamercolor{institute}{fg=black}
    \fi
}}

% Define a standout frame
\newcommand{\standoutframe}[2]{{
    \setbeamertemplate{background canvas}[default]
    \setbeamercolor{background canvas}{bg=mitred}
    \setbeamercolor{normal text}{fg=white}
    \usebeamercolor[fg]{normal text}
    \begin{frame}[plain,c]
        \begin{center}
            \vspace{1.2cm}
            \Huge\bfseries {#1}\\
            \vspace{0.1cm}
            \LARGE\bfseries {#2}
        \end{center}
    \end{frame}
}}

% Define a references frame
\newcommand{\referencesframe}{
    \begin{frame}[allowframebreaks]
        \frametitle<presentation>{References}
        \begin{myblock}
            \printbibliography
        \end{myblock}
    \end{frame}
}

% Define an outline frame
\newcommand{\outlineframe}{
    \begin{frame}[allowframebreaks]
        {Outline}
        \tableofcontents
    \end{frame}
}

% Define a section title frame
\newcommand{\sectiontitleframe}{{
    \usebackgroundtemplate{
        \includegraphics[width=\paperwidth,height=\paperheight]{background/background4.pdf}
    }
    \begin{frame}[plain,c]
        \begin{center}
            \vspace{1.0cm}
            \Large Section \insertsectionnumber\\
            \vspace{0.1cm}
            \hypersetup{linkcolor=mitred}
            \Huge\bfseries\textcolor{mitred}{\insertsectionhead}\\
            \vspace{1.0cm}
            \small\textcolor{mitgray}{Slides \insertsectionstartpage -\insertsectionendpage}
        \end{center}
    \end{frame}
}}

\mode<all>